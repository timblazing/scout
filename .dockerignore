# Keep the build context small and reproducible.
.git
.github
.gitignore
.DS_Store

# Build output
bin/
orangutan
*.exe

# Frontend deps and output are rebuilt inside the image
web/node_modules/
internal/web/dist/

# Local data and editor state
data/
*.log
.claude/
.playwright-mcp/
.vscode/
.idea/

# Docs and packaging that the image does not need
docs/
snap/
systemd/
*.md
!README.md
